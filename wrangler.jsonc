{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enterprise-ai-assistant",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    // URL of the Acme MCP server (separate Worker; `yarn workspace mcp-server dev`
    // serves it on :8788). The orchestrator connects here and degrades gracefully
    // if it is unreachable.
    "MCP_URL": "http://localhost:8788/mcp"
  },
  // Source of truth for skills (CONTEXT.md §6). Seed locally with `yarn seed`;
  // the bundled SKILL.md import is the fallback if this is empty/unavailable.
  // The id is a placeholder for local dev (MVP is local-only).
  "kv_namespaces": [{ "binding": "SKILLS", "id": "skills_local_placeholder" }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      },
      {
        // Single shared store for cross-user leave requests (scenario 9).
        "class_name": "LeaveStore",
        "name": "LEAVE_STORE"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["LeaveStore"],
      "tag": "v2"
    }
  ]
}
