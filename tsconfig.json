{
  "extends": "agents/tsconfig",
  "compilerOptions": {
    // Runtime types come from `wrangler types` (env.d.ts), not the
    // @cloudflare/workers-types package.
    "types": ["node", "vite/client"]
  },
  // The mcp-server workspace is a separate Worker with its own tsconfig and
  // generated types; keep it out of the app's type program.
  "include": ["src", "test", "env.d.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", ".wrangler", "mcp-server"]
}
