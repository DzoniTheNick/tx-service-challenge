{
  "name": "enterprise-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI assistant for first-level IT and HR support (Cloudflare Agents)",
  "keywords": [
    "agents",
    "ai",
    "cloudflare",
    "mcp"
  ],
  "license": "MIT",
  "workspaces": [
    "mcp-server"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:all": "concurrently -n app,mcp -c blue,magenta \"yarn dev\" \"yarn workspace mcp-server dev\"",
    "start": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "seed": "wrangler kv bulk put --binding SKILLS --local ./scripts/skills-kv.json",
    "reset": "rm -rf .wrangler/state && yarn seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ mcp-server/src/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p mcp-server/tsconfig.json",
    "check": "oxfmt --check . && yarn lint && yarn typecheck"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.204",
    "@cloudflare/ai-chat": "0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "hono": "^4.13.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/runner": "3.2.4",
    "@vitest/snapshot": "3.2.4",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "3.2.4",
    "wrangler": "^4.113.0"
  },
  "dependenciesMeta": {
    "core-js-pure": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "sharp": {
      "built": true
    },
    "workerd": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"
}
