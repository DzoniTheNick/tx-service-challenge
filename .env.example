# Cloudflare credentials for Workers AI (copy to .env — .env is gitignored).
# These are the same two values already in your .autoenv.zsh.
#
# The API token must carry the "Edit Cloudflare Workers" permissions, i.e.
# Workers Scripts: Edit  +  Workers AI: Read  (the dashboard template plus the
# Workers AI row). A Workers-AI-only token is NOT enough — local dev needs to
# create a remote preview session, which requires Workers Scripts: Edit.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Optional — MCP failure-mode switch for demonstration scenario 7.
# "ok" (default) | "error" (every MCP tool returns an error) | "timeout"
# (every MCP tool hangs past the client's 5s bound). Leave unset for normal runs.
# MCP_MODE=error

